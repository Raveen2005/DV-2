{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Public Transport Stops Across Melbourne by Mode",
  "width": 900,
  "height": 600,

  "params": [
    {
      "name": "ModeSelect",
      "value": "METRO BUS",
      "bind": {
        "input": "select",
        "options": [
          null,
          "METRO BUS",
          "METRO TRAIN",
          "METRO TRAM",
          "REGIONAL BUS",
          "REGIONAL TRAIN",
          "REGIONAL COACH",
          "INTERSTATE TRAIN",
          "SKYBUS"
        ],
        "labels": [
          "All modes",
          "Metro Bus",
          "Metro Train",
          "Metro Tram",
          "Regional Bus",
          "Regional Train",
          "Regional Coach",
          "Interstate Train",
          "SkyBus"
        ],
        "name": "Select mode: "
      }
    }
  ],

  "projection": {
    "type": "mercator",
    "center": [144.9631, -37.8136],
    "scale": 30000
  },

  "layer": [
    {
      "data": {
        "url": "data/suburbs.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#bdbdbd",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/stops.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "filter": "ModeSelect == null || datum.properties.MODE == ModeSelect"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "size": 14,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {"field": "geometry.coordinates[0]", "type": "quantitative"},
        "latitude": {"field": "geometry.coordinates[1]", "type": "quantitative"},
        "color": {
          "field": "properties.MODE",
          "type": "nominal",
          "title": "Transport Mode",
          "scale": {
            "domain": [
              "METRO BUS",
              "METRO TRAIN",
              "METRO TRAM",
              "REGIONAL BUS",
              "REGIONAL TRAIN",
              "REGIONAL COACH",
              "INTERSTATE TRAIN",
              "SKYBUS"
            ],
            "range": [
              "#F28E2B",
              "#E15759",
              "#76B7B2",
              "#59A14F",
              "#B07AA1",
              "#EDC948",
              "#4E79A7",
              "#FF9DA7"
            ]
          }
        },
        "tooltip": [
          {"field": "properties.STOP_NAME", "title": "Stop"},
          {"field": "properties.MODE", "title": "Mode"}
        ]
      }
    }
  ]
}